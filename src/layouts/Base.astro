---
// みやざきゼミのサイト（kosei.page/seminar/）の枠。デザインはみやざきゼミの基準。
// kosei.page 本体とは別サイトの扱い：ヘッダー左はゼミのロゴ、右に about・contact・kosei.page。
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = '兵庫大学 現代ビジネス学部 宮崎ゼミ。きいて、しらべて、つくります。' } = Astro.props;
const pageTitle = title ? `${title} | みやざきゼミ` : 'みやざきゼミ';
const links = [
  { href: '/about/', label: 'about' },
  { href: '/contact/', label: 'contact' },
  { href: '/', label: 'kosei.page' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yusei+Magic&family=Zen+Kaku+Gothic+New:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="semi-header">
      <div class="inner wrap">
        <nav class="semi-nav" aria-label="リンク">
          {links.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="semi-main">
      <slot />
    </main>
    <footer class="site wrap">
      <p class="muted">© kosei.page</p>
    </footer>
  </body>
</html>
