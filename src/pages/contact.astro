---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const ready = Boolean(site.turnstileSiteKey);
---
<Base title="ご相談">
  <div class="prose">
    <h1>ご相談</h1>
    <p>次のようなご相談をお受けしています。</p>
    <ul>
      <li>自治体・企業向けの研修、講演（DX、AI活用、データ活用）</li>
      <li>組織変革やAI導入の進め方についての助言</li>
      <li>ゼミとの連携（取材、調査、地域のイベント）</li>
    </ul>

    {ready ? (
      <form id="contact" class="form" novalidate>
        <label>お名前<span class="req">必須</span><input name="name" required maxlength="100" autocomplete="name" /></label>
        <label>ご所属<input name="org" maxlength="200" autocomplete="organization" /></label>
        <label>メールアドレス<span class="req">必須</span><input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
        <label>ご相談の内容<span class="req">必須</span><textarea name="message" required maxlength="4000" rows="8"></textarea></label>
        <div class="hp" aria-hidden="true"><label>ウェブサイト<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div id="turnstile" data-sitekey={site.turnstileSiteKey}></div>
        <button type="submit"><span class="mark">送信する</span></button>
        <p id="status" class="muted" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <p class="muted">お問い合わせフォームは準備中です。</p>
    )}
  </div>

  {ready && (
    <>
      <script is:inline>
        let widgetId;
        window.onTurnstileLoad = () => {
          const el = document.getElementById('turnstile');
          widgetId = window.turnstile.render(el, { sitekey: el.dataset.sitekey, action: 'contact', language: 'ja' });
        };
        const form = document.getElementById('contact');
        const status = document.getElementById('status');
        const messages = {
          required: 'お名前、メールアドレス、ご相談の内容を入力してください。',
          email: 'メールアドレスの形式を確認してください。',
          too_long: '入力が長すぎます。ご相談の内容は4000字以内でお願いします。',
          captcha: '確認が完了していません。少し待ってから、もう一度送信してください。',
        };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button');
          btn.disabled = true;
          status.textContent = '送信しています…';
          try {
            const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
            const data = await res.json().catch(() => ({}));
            if (data.ok) {
              form.reset();
              form.querySelectorAll('input, textarea, button').forEach((el) => (el.disabled = true));
              status.textContent = '送信しました。内容を確認して、ご連絡いたします。';
              return;
            }
            status.textContent = messages[data.error] || '送信できませんでした。時間をおいて、もう一度お試しください。';
          } catch {
            status.textContent = '送信できませんでした。時間をおいて、もう一度お試しください。';
          }
          if (window.turnstile && widgetId !== undefined) window.turnstile.reset(widgetId);
          btn.disabled = false;
        });
      </script>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
    </>
  )}
</Base>

<style>
  .form { display: grid; gap: var(--space-4); margin-top: var(--space-8); }
  .form label { display: grid; gap: var(--space-1); font-weight: 700; font-size: 15px; }
  .req { margin-left: var(--space-2); font-weight: 500; font-size: 12px; color: var(--ink-muted); }
  .form input, .form textarea { font: inherit; font-weight: 500; color: var(--ink); padding: var(--space-3);
    border: 1px solid #CFCFCF; border-radius: var(--radius-sm); background: var(--paper); }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--ink); outline-offset: 1px; }
  .form button { justify-self: start; font: inherit; font-weight: 700; font-size: 17px; padding: 0; border: 0; background: none; cursor: pointer; }
  .form button .mark { display: inline-block; padding: var(--space-2) var(--space-6); }
  .form button:disabled { opacity: 0.5; cursor: default; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
