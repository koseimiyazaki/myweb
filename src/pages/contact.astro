---
import Material from '../layouts/Material.astro';
import { site } from '../data/site';
const ready = Boolean(site.turnstileSiteKey);
const alert = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16.5v.01"/></svg>';
---
<Material title="ご相談">
  <h1 class="am-page-title">ご相談</h1>
  <div class="am-content">
    <div class="am-prose am-measure">
      <p>自治体・企業向けの研修や講演（DX、AI活用、データ活用）、組織変革やAI導入の進め方についてのご相談をお受けしています。</p>
    </div>

    {ready ? (
      <form id="contact" class="form am-measure" novalidate>
        <label class="am-field"><input class="am-input" name="name" placeholder=" " required maxlength="100" autocomplete="name" /><span class="am-field__label">お名前（必須）</span></label>
        <label class="am-field"><input class="am-input" name="org" placeholder=" " maxlength="200" autocomplete="organization" /><span class="am-field__label">ご所属</span></label>
        <label class="am-field"><input class="am-input" name="email" type="email" placeholder=" " required maxlength="200" autocomplete="email" /><span class="am-field__label">メールアドレス（必須）</span></label>
        <label class="am-field"><textarea class="am-input" name="message" placeholder=" " required maxlength="4000" rows="6"></textarea><span class="am-field__label">ご相談の内容（必須）</span></label>
        <div class="hp" aria-hidden="true"><label>ウェブサイト<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div id="turnstile" data-sitekey={site.turnstileSiteKey}></div>
        <div><button class="am-btn" type="submit">送信する</button></div>
        <p id="status" class="am-field__support" role="status" aria-live="polite"></p>
        <p id="error" class="am-field__error" hidden><Fragment set:html={alert} /><span></span></p>
      </form>
    ) : (
      <p class="am-field__support">お問い合わせフォームは準備中です。</p>
    )}
  </div>

  {ready && (
    <>
      <script is:inline>
        let widgetId;
        window.onTurnstileLoad = () => {
          const el = document.getElementById('turnstile');
          widgetId = window.turnstile.render(el, { sitekey: el.dataset.sitekey, action: 'contact', language: 'ja' });
        };
        const form = document.getElementById('contact');
        const status = document.getElementById('status');
        const error = document.getElementById('error');
        const showError = (msg) => { error.querySelector('span').textContent = msg; error.hidden = false; status.textContent = ''; };
        const messages = {
          required: 'お名前、メールアドレス、ご相談の内容を入力してください。',
          email: 'メールアドレスの形式を確認してください。',
          too_long: '入力が長すぎます。ご相談の内容は4000字以内でお願いします。',
          captcha: '確認が完了していません。少し待ってから、もう一度送信してください。',
        };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button');
          btn.disabled = true;
          error.hidden = true;
          status.textContent = '送信しています。';
          try {
            const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
            const data = await res.json().catch(() => ({}));
            if (data.ok) {
              form.reset();
              form.querySelectorAll('input, textarea, button').forEach((el) => (el.disabled = true));
              status.textContent = '送信しました。内容を確認して、ご連絡します。';
              return;
            }
            showError((messages[data.error] || '送信できませんでした。時間をおいて、もう一度お試しください。') + (data.reason ? `（${data.reason}）` : ''));
          } catch {
            showError('送信できませんでした。時間をおいて、もう一度お試しください。');
          }
          if (window.turnstile && widgetId !== undefined) window.turnstile.reset(widgetId);
          btn.disabled = false;
        });
      </script>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
    </>
  )}
</Material>

<style is:global>
  .form { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
