---
import Material from '../layouts/Material.astro';
import { works } from '../data/works';
---
<Material home>
  <div class="am-content">
    <div class="am-grid">
      {works.map((w) => (
        <article class="am-card am-card--outlined">
          <h2 class="am-card__heading">{w.title}</h2>
          <div class="am-card__actions">
            <a class="am-btn am-btn--tonal" href={w.url} target="_blank" rel="noopener">開く</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Material>
