---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const essays = (await getCollection('essays', (e) => !e.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="検索とAI">
  <div class="prose">
    <h1>検索とAI</h1>
    <p>人はどうやって情報を見つけ、どう判断しているのか。ヤフーで、人手によるウェブの分類からロボット型検索への移行、検索品質の評価と改善までを現場で経験しました。生成AIで検索のかたちが変わりつつあるいま、<span class="mark">情報の見つけ方が変わると、人と組織の判断はどう変わるか</span>を考えています。</p>
  </div>

  {essays.length > 0 && (
    <>
      <h2>論考</h2>
      <dl class="list">
        {essays.map((e) => (
          <div>
            <dt>{e.data.date.getFullYear()}.{e.data.date.getMonth() + 1}</dt>
            <dd><a href={`/search/${e.id}/`}>{e.data.title}</a>{e.data.summary && <><br /><span class="muted">{e.data.summary}</span></>}</dd>
          </div>
        ))}
      </dl>
    </>
  )}

  <h2>検索に関する著作</h2>
  <ul class="prose">
    <li>「Yahoo! Search Technology (YST) と検索分野におけるYahoo! JAPANの戦略」情報処理 46(9)（2005）</li>
  </ul>
</Base>
