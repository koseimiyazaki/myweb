---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', (e) => !e.data.draft);
  return essays.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
---
<Base title={e.data.title} description={e.data.summary}>
  <article class="prose">
    <p class="muted">{e.data.date.getFullYear()}年{e.data.date.getMonth() + 1}月　<a href="/search/">検索とAI</a></p>
    <h1>{e.data.title}</h1>
    <Content />
  </article>
</Base>
