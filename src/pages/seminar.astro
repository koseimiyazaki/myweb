// 年度で区切る（4月はじまり）。when の「YYYY年M月」から年度を出す。月がなければ year をそのまま年度とする
const ym = (p) => { const m = (p.when ?? '').match(/(\d{4})年(\d{1,2})月/); return m ? [Number(m[1]), Number(m[2])] : [p.year, 0]; };
const fyOf = (p) => { const [y, mo] = ym(p); return mo && mo < 4 ? y - 1 : y; };
// 予定の企画は年度の先頭に出す
const sortKey = (p) => { if ((p.when ?? '').includes('予定')) return Infinity; const [y, mo] = ym(p); return y * 100 + mo; };
const years = [...new Set(projects.map(fyOf))].sort((a, b) => b - a);
const inYear = (fy) => projects.filter((p) => fyOf(p) === fy).sort((a, b) => sortKey(b) - sortKey(a));
const json = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
---
<Base>
  <section class="banner">
    <div class="banner__inner wrap">
      <img class="banner__logo" src="/seminar/logo_yoko_yellow.png" alt="兵庫大学 現代ビジネス学部 みやざきゼミ" width="1600" height="341" />
      <p class="banner__copy hand"><span>きいて、</span><span>しらべて、</span><span>つくります。</span></p>
    </div>
  </section>

  <div class="wrap semi-body">
    <div class="semi-lead">
      <p>地域のDXに携わる実務家の教員のもとで、実践を重んじて学ぶゼミです。<br class="br-wide" />地域の持続に取り組む方々の役に立てるよう、活動の現場でデータをとり、分析し、<br class="br-wide" />関わる人と話し合いながら、課題解決を模索します。</p>
      <p>まちの人の話をきき、データでしらべ、わかったことをかたちにする。<br class="br-wide" />気軽に相談できる「いちばん近くの大学生」でありたいと思っています。</p>
    </div>

    <section class="semi-section" aria-labelledby="goals-h">
      <h2 class="semi-h2" id="goals-h">ゼミで育てる力</h2>
      <SeminarGoals />
    </section>

    <section class="semi-section" aria-labelledby="scenes-h">
      <h2 class="semi-h2" id="scenes-h">ゼミの風景</h2>
    <div class="scenes">
      <figure class="scene">
        <img src="/seminar/projects/2026-seminar-scene.jpg" alt="自作のまちづくりイベント用アプリをデモする学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>まちづくりアプリのデモ（2026年6月）</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2026-seminar-scene-2.jpg" alt="教室のあちこちで、自作のアプリを試し合う学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>アプリを試し合う（2026年6月）</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2023-seminar-scene.jpg" alt="ゼミの教室で、スクリーンの映像を見ながら話し合う学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>2023年のゼミ</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/seminar-scene-gallery.jpg" alt="壁に貼った資料を見て回る学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>ゼミの風景</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/company-visit.jpg" alt="企業のラウンジで担当の方の話を聞く学生たち" width="1086" height="724" loading="lazy" />
        <figcaption>企業訪問</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2024-nokisaki-result-1.jpg" alt="スクリーンのグラフを前に調査結果を発表する学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>調査結果の発表</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2024-consensus-game.jpg" alt="コンセンサスゲームで、ホワイトボードに順位を書き出す学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>コンセンサスゲーム（2024年10月）</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2024-interview-roleplay.jpg" alt="面接に向けたロールプレイングで、シートに書き込む学生たち" width="768" height="1024" loading="lazy" />
        <figcaption>面接に向けたロールプレイング</figcaption>
      </figure>
    </div>



    </section>

    <section class="works semi-section" aria-labelledby="works-h">
      <div class="works__head">
        <h2 class="semi-h2" id="works-h">これまでの企画</h2>
        <div class="chips" role="group" aria-label="絞り込み">
          <button type="button" class="chip" aria-pressed="true" data-filter="">すべて</button>
          <button type="button" class="chip" aria-pressed="false" data-filter="ゼミ">ゼミ</button>
          <button type="button" class="chip" aria-pressed="false" data-filter="プロジェクト演習">プロジェクト演習・ソトマナビ</button>
        </div>
      </div>
      {years.map((y, yi) => (
        <section class="year" data-year={y} data-old={yi >= 2 ? "1" : undefined}>
          <h3 class="year__label hand">{y}<span class="year__unit">年度</span></h3>
          <div class="cards">
            {inYear(y).map((p) => {
              const photos = p.photo ? [{ src: p.photo, alt: p.alt }, ...(p.more ?? [])] : [];
              return (
                <button type="button" class="card" data-tags={(p.tags ?? []).join(' ')}
                  data-item={json({ title: p.title, when: p.when ?? `${p.year}年`, text: p.text, tags: p.tags ?? [], link: p.link ?? null, photos })}>
                  <span class="card__img">
                    {p.photo ? <img src={p.photo} alt={p.alt} loading="lazy" /> : <span class="card__noimg hand">{p.title}</span>}
                    {photos.length > 1 && <span class="card__count">{photos.length}枚</span>}
                  </span>
                  <span class="card__when">{p.when ?? `${p.year}年`}</span>
                  <span class="card__title">{p.title}</span>
                  <span class="card__tags">{(p.tags ?? []).map((t) => <span class="tag">{t}</span>)}</span>
                </button>
              );
            })}
          </div>
        </section>
      ))}
      {years.length > 2 && (
        <p class="years-more"><button type="button" class="chip" id="years-more">それ以前の年度も見る（{years.slice(2).map((y) => `${y}`).join('・')}年度）</button></p>
      )}
    </section>

    <NoteFeed noteId={site.seminarNoteId} heading="ゼミのnote" />

    <p class="semi-formal">兵庫大学 現代ビジネス学部 宮崎ゼミ</p>
  </div>

  <dialog class="viewer" aria-labelledby="viewer-title">
    <div class="viewer__photo">
      <img alt="" />
      <button type="button" class="viewer__nav viewer__prev" aria-label="前の写真">‹</button>
      <button type="button" class="viewer__nav viewer__next" aria-label="次の写真">›</button>
      <span class="viewer__pos"></span>
    </div>
    <div class="viewer__body">
      <p class="viewer__when"></p>
      <h3 class="viewer__title" id="viewer-title"></h3>
      <p class="viewer__tags"></p>
      <p class="viewer__text"></p>
      <p class="viewer__link"></p>
    </div>
    <button type="button" class="viewer__close" aria-label="閉じる">×</button>
  </dialog>

  <script is:inline>
    (() => {
      const dlg = document.querySelector('.viewer');
      const img = dlg.querySelector('.viewer__photo img');
      const pos = dlg.querySelector('.viewer__pos');
      let item = null, i = 0;
      const photoBox = dlg.querySelector('.viewer__photo');
      const show = () => {
        photoBox.hidden = item.photos.length === 0; dlg.classList.toggle('viewer--text', item.photos.length === 0);
        if (!item.photos.length) return;
        const ph = item.photos[i];
        img.src = ph.src; img.alt = ph.alt;
        pos.textContent = item.photos.length > 1 ? `${i + 1} / ${item.photos.length}` : '';
        dlg.querySelectorAll('.viewer__nav').forEach((b) => (b.hidden = item.photos.length < 2));
      };
      document.querySelectorAll('.card').forEach((c) => c.addEventListener('click', () => {
        item = JSON.parse(c.dataset.item); i = 0;
        dlg.querySelector('.viewer__when').textContent = item.when;
        dlg.querySelector('.viewer__title').textContent = item.title;
        dlg.querySelector('.viewer__tags').textContent = item.tags.map((t) => '#' + t).join(' ');
        dlg.querySelector('.viewer__text').textContent = item.text;
        const link = dlg.querySelector('.viewer__link');
        link.innerHTML = '';
        if (item.link) { const a = document.createElement('a'); a.href = item.link.href; a.target = '_blank'; a.rel = 'noopener'; a.textContent = item.link.label; link.append(a); }
        show(); dlg.showModal();
      }));
      const step = (d) => { if (!item || !item.photos.length) return; i = (i + d + item.photos.length) % item.photos.length; show(); };
      dlg.querySelector('.viewer__prev').addEventListener('click', () => step(-1));
      dlg.querySelector('.viewer__next').addEventListener('click', () => step(1));
      dlg.querySelector('.viewer__close').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });

      const works = document.querySelector('.works');
      const more = document.getElementById('years-more');
      if (more) more.addEventListener('click', () => { works.classList.add('show-all'); more.parentElement.remove(); });
      const chips = [...document.querySelectorAll('.chips .chip')];
      chips.forEach((ch) => ch.addEventListener('click', () => {
        works.classList.add('show-all'); if (more && more.parentElement) more.parentElement.remove();
        chips.forEach((x) => x.setAttribute('aria-pressed', x === ch));
        const f = ch.dataset.filter;
        document.querySelectorAll('.year').forEach((y) => {
          let n = 0;
          y.querySelectorAll('.card').forEach((c) => { const on = !f || c.dataset.tags.split(' ').includes(f); c.hidden = !on; if (on) n++; });
          y.hidden = n === 0;
        });
      }));
    })();
  </script>
</Base>
