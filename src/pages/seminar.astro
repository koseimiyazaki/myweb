---
import Base from '../layouts/Base.astro';
import NoteFeed from '../components/NoteFeed.astro';
import { site } from '../data/site';

// 用件（短い名詞）＋ひとこと（話しかける口調）。並びは きく→しらべる→つくる の順。
const activities = [
  { verb: 'きいて・しらべて', title: 'まちのアンケート', say: '東加古川軒先市場で、まちの声をきいています。', since: '2024年〜' },
  { verb: 'つくります', title: '兵庫のブランドのnote', say: 'じっさいに つかって、たずねて、かいています。', since: '2026年〜' },
];

// これまでの企画。新しいものを上に足す。写真は public/seminar/projects/ に、位置情報を消して置く。
const projects = [
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年7月',
    title: 'スマホ教室＠コープ稲美',
    text: 'コープ稲美で、地域の方のスマホの使い方の相談に、学生が1人ずつ付いて一緒に向き合いました。',
    photo: '/seminar/projects/2024-inami-smartphone-2.jpg',
    alt: '学生と地域の方が、机の上のスマホを一緒にのぞき込む様子',
    more: [
      { src: '/seminar/projects/2024-inami-smartphone-3.jpg', alt: '学生2人が地域の方のスマホの操作を手伝う様子' },
      { src: '/seminar/projects/2024-inami-smartphone-class.jpg', alt: '店舗の一室で、学生と地域の方が向かい合ってスマホを操作する様子' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2024,
    when: '2024年6月',
    title: '東加古川軒先市場の調査',
    text: '手動のカウンターとAIカメラで、軒先市場に来る人の流れを調べ、来場者アンケートとあわせて分析して報告しました。',
    photo: '/seminar/projects/2024-nokisaki-survey-camera.jpg',
    alt: '人数を数えるAIカメラと、個人情報を取得しない旨の掲示',
    more: [
      { src: '/seminar/projects/2024-nokisaki-survey-walk.jpg', alt: '調査ルートを歩く学生たち' },
      { src: '/seminar/projects/2024-nokisaki-survey-report.jpg', alt: '調査の方法を説明する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-1.jpg', alt: '来場者アンケートの結果を報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-2.jpg', alt: 'イベントを知った経路の結果を報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-4.jpg', alt: '手動カウンターとAIカメラの計測結果を比べて報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-6.jpg', alt: 'AIカメラの計測結果を解説する様子' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年5月',
    title: 'スマホ教室＠東加古川軒先市場',
    text: '東加古川軒先市場に出張して、まちの人のスマホの困りごとに学生が一緒に向き合いました。',
    photo: '/seminar/projects/2024-nokisaki-smartphone-class.jpg',
    alt: 'スマホの使い方を一緒に確かめる学生と来場者',
    more: [
      { src: '/seminar/projects/2024-nokisaki-smartphone-board.jpg', alt: 'ホワイトボードに「スマホ教室」と書く学生たち' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年4〜5月',
    title: 'スマホ相談会',
    text: 'コープの店舗で、学生が相談役になってスマホ相談会を開きました。準備から当日の対応まで、学生が進めています。',
    photo: '/seminar/projects/2024-smartphone-consult.jpg',
    alt: '学生と一緒にスマホを操作する相談者',
    more: [
      { src: '/seminar/projects/2024-smartphone-class.jpg', alt: 'スマホの操作を一緒に確かめる学生と相談者' },
      { src: '/seminar/projects/2024-smartphone-prep.jpg', alt: '教室で相談会の準備をする学生たち' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年2月',
    title: 'TSUMAMIGUI TIME',
    text: 'コープこうべの直営農場「コープエコファーム」の資源循環の取り組みを紹介しようと、採れた野菜を使ってクルチャの試食会を開きました。',
    photo: '/seminar/projects/2024-tsumamigui-plates.jpg',
    alt: '皿に盛りつけた試食用のクルチャ',
    more: [
      { src: '/seminar/projects/2024-tsumamigui-trial.jpg', alt: '試作したクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-prep.jpg', alt: '調理室で仕込みを始める学生' },
      { src: '/seminar/projects/2024-tsumamigui-time.jpg', alt: 'フライパンで焼いているほうれん草とチーズのクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-banner.jpg', alt: '試食会ののぼり' },
      { src: '/seminar/projects/2024-tsumamigui-booth.jpg', alt: '開始前の試食会のブース' },
    ],
    link: { href: 'https://www.instagram.com/p/C34ELkVp7wW/', label: 'Instagramで見る' },
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2022,
    title: '未知を感じる自然ツアー',
    text: '自然の中で、子どもたちが小さな挑戦を重ねて自分を知っていくツアーを企画し、実施しました。',
    photo: '/seminar/projects/2022-michi-nature-tour.jpg',
    alt: '企画を書き出したホワイトボード',
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2022,
    title: 'ソトマナビ広報',
    text: '学生のアクティブラーニングの活動を、ポスターにして展示しました。',
    photo: '/seminar/projects/2022-sotomanabi-poster.jpg',
    alt: '教室に並んだポスターを見る学生たち',
  },
];
---
<Base>
  <section class="banner">
    <div class="banner__inner wrap">
      <img class="banner__logo" src="/seminar/logo_yoko_yellow.png" alt="兵庫大学 現代ビジネス学部 みやざきゼミ" width="1600" height="341" />
      <p class="banner__copy hand"><span>きいて、</span><span>しらべて、</span><span>つくります。</span></p>
    </div>
  </section>

  <div class="wrap semi-body">
    <div class="semi-lead">
      <p>地域のDXに携わる実務家の教員のもとで、実践を重んじて学ぶゼミです。地域の持続に取り組む事業者の方々と組んで、活動の現場でデータをとり、分析し、関わる人と話し合いながら、次の一手につなげていきます。</p>
      <p>まちの人の話をきき、データでしらべ、わかったことをかたちにする。まちのことを気軽に聞きに来られる「近所の大学生」でありたいと思っています。</p>
    </div>

    <div class="scenes">
      <figure class="scene">
        <img src="/seminar/projects/2023-seminar-scene.jpg" alt="ゼミの教室で、スクリーンの映像を見ながら話し合う学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>2023年のゼミ</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/seminar-scene-gallery.jpg" alt="壁に貼った資料を見て回る学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>ゼミの風景</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/company-visit.jpg" alt="企業のラウンジで担当の方の話を聞く学生たち" width="1086" height="724" loading="lazy" />
        <figcaption>企業訪問</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/2024-nokisaki-result-1.jpg" alt="スクリーンのグラフを前に調査結果を発表する学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>調査結果の発表</figcaption>
      </figure>
    </div>


    <h2 class="semi-h2">やっていること</h2>
    <div class="semi-boards">
      {activities.map((a) => (
        <article class="board">
          <p class="board__verb">{a.verb}</p>
          <h3 class="board__title">{a.title}</h3>
          <p class="board__say hand">{a.say}</p>
          <p class="board__since">{a.since}</p>
        </article>
      ))}
    </div>

    <h2 class="semi-h2">これまでの企画</h2>
    <div class="projects">
      {projects.map((p) => (
        <figure class="project">
          <img class="project__main" src={p.photo} alt={p.alt} loading="lazy" />
          {p.more && (
            <div class="project__thumbs">
              {[{ src: p.photo, alt: p.alt }, ...p.more].map((m, i) => (
                <button type="button" class="project__thumb" aria-pressed={i === 0 ? 'true' : 'false'} data-src={m.src} data-alt={m.alt} aria-label={`写真${i + 1}を表示`}>
                  <img src={m.src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
          <figcaption>
            <p class="project__year">{p.when ?? `${p.year}年`}{p.tags && <span class="project__tags">{p.tags.map((t) => `#${t}`).join(' ')}</span>}</p>
            <h3 class="project__title">{p.title}</h3>
            <p class="project__text">{p.text}</p>
            {p.link && <p class="project__link"><a href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a></p>}
          </figcaption>
        </figure>
      ))}
    </div>

    <NoteFeed noteId={site.seminarNoteId} heading="ゼミのnote" />

    <p class="semi-formal">兵庫大学 現代ビジネス学部 宮崎ゼミ</p>
  </div>
  <script is:inline>
    document.querySelectorAll('.project__thumbs').forEach((row) => {
      const main = row.parentElement.querySelector('.project__main');
      row.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        main.src = b.dataset.src; main.alt = b.dataset.alt;
        row.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', x === b));
      }));
    });
  </script>
</Base>
