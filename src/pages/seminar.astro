    photo: '/seminar/projects/2023-takasago-pitch-title.jpg',
    alt: '「Linc高砂＋兵庫大学 Pitch meeting!!」のスライドとソトマナビののぼり',
    more: [
      { src: '/seminar/projects/2023-takasago-pitch-2.jpg', alt: '事業のアイデアをピッチする学生（発表者名はぼかしています）' },
      { src: '/seminar/projects/2023-takasago-pitch-3.jpg', alt: '「未知を感じる自然ツアー」を発表する学生たち（発表者名はぼかしています）' },
      { src: '/seminar/projects/2023-takasago-pitch-1.jpg', alt: 'ソトマナビのプロジェクトを紹介する学生たち' },
      { src: '/seminar/projects/2023-takasago-pitch-posters.jpg', alt: '会場に並んだプロジェクト紹介のポスター' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
