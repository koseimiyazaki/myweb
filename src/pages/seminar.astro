    text: '自然の中で、子どもたちが小さな挑戦を重ねて自分を知っていくツアーを企画し、実施しました。',
    photo: '/seminar/projects/2022-michi-nature-tour.jpg',
    alt: '企画を書き出したホワイトボード',
    more: [
      { src: '/seminar/projects/2022-nature-tour-1.jpg', alt: '丘の上で集まる子どもたちと学生（遠景）' },
      { src: '/seminar/projects/2022-nature-tour-2.jpg', alt: '広場でアクティビティをする子どもたちと学生' },
      { src: '/seminar/projects/2022-nature-tour-5.jpg', alt: 'ツアーの舞台になった公園の広場' },
      { src: '/seminar/projects/2022-nature-tour-3.jpg', alt: '森の中で食事の準備をする様子' },
      { src: '/seminar/projects/2022-nature-tour-4.jpg', alt: '森の中の炊事場に集まる子どもたちと学生' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2022,
    title: 'ソトマナビ広報',
    text: '学生のアクティブラーニングの活動を、ポスターにして展示しました。',
    photo: '/seminar/projects/2022-sotomanabi-poster.jpg',
    alt: '教室に並んだポスターを見る学生たち',
  },
  {
    tags: ['プロジェクト演習'],
    year: 2022,
    when: '2022年5月',
    title: '神戸のビジネスコンテストに挑戦',
    text: '学生が自分たちで練った事業のアイデアを、神戸のビジネスコンテストで発表しました。準備の段階から教員も一緒に構想を練りました。',
    photo: '/seminar/projects/2022-kobe-bizcon-1.jpg',
    alt: 'ビジネスコンテストの会場で事業のアイデアを発表する学生（発表者名はぼかしています）',
    more: [
      { src: '/seminar/projects/2022-kobe-bizcon-2.jpg', alt: '睡眠をテーマにしたアイデアを発表する学生' },
      { src: '/seminar/projects/2022-kobe-bizcon-3.jpg', alt: '学生と教員が事業の構想を話し合う様子' },
