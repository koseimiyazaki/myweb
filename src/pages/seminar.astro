---
import Base from '../layouts/Base.astro';
import NoteFeed from '../components/NoteFeed.astro';
import { site } from '../data/site';

// 用件（短い名詞）＋ひとこと（話しかける口調）。並びは きく→しらべる→つくる の順。
const activities = [
  { verb: 'きいて・しらべて', title: 'まちのアンケート', say: '東加古川軒先市場で、まちの声をきいています。', since: '2024年〜' },
  { verb: 'つくります', title: '兵庫のブランドのnote', say: 'じっさいに つかって、たずねて、かいています。', since: '2026年〜' },
];

// これまでの企画。新しいものを上に足す。写真は public/seminar/projects/ に、位置情報を消して置く。
const projects = [
  {
    tags: ['ゼミ'],
    year: 2025,
    when: '2025年10月',
    title: '神戸マッチ株式会社への提案づくり',
    text: '訪問で学んだことをもとに、hibiのお客さまの姿を思い描き、出会いから購入、使い続けるまでの流れを描いて、神戸マッチへの提案を検討しました。',
    photo: '/seminar/projects/2025-kobematch-proposal-map.jpg',
    alt: 'カスタマージャーニーマップをホワイトボードに書き込む学生の手元',
    more: [
      { src: '/seminar/projects/2025-kobematch-proposal-board.jpg', alt: 'ホワイトボードで提案の構成を話し合う学生たち' },
      { src: '/seminar/projects/2025-kobematch-proposal-room.jpg', alt: 'グループに分かれて提案を検討する教室' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2025,
    when: '2025年7月',
    title: '神戸マッチ株式会社を訪問',
    text: 'マッチの老舗・神戸マッチを訪ね、お香ブランド「hibi」のブランド戦略、商品企画、製造工程について学びました。',
    photo: '/seminar/projects/2025-kobematch-match.jpg',
    alt: 'マッチを擦る手元',
    more: [
      { src: '/seminar/projects/2025-kobematch-welcome.jpg', alt: '「Welcome to KOBE MATCH」の歓迎ボード' },
      { src: '/seminar/projects/2025-kobematch-lecture.jpg', alt: 'ブランドについての説明を聞く学生たち' },
      { src: '/seminar/projects/2025-kobematch-scent.jpg', alt: 'hibiの香りを確かめる学生' },
      { src: '/seminar/projects/2025-kobematch-factory.jpg', alt: '製造の機械の説明を聞く学生たち' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2025,
    when: '2025年6月',
    title: '東加古川軒先市場の調査',
    text: '「大学生の地域交流を増やす」をテーマに、調査の企画から、当日のアンケートとカメラによる人数の計測、分析、報告までを学生が進めました。',
    photo: '/seminar/projects/2025-nokisaki-interview.jpg',
    alt: '軒先市場で来場者にアンケートをお願いする学生',
    more: [
      { src: '/seminar/projects/2025-nokisaki-todo.jpg', alt: '「今日やるぞ」と準備の項目を書き出したホワイトボード' },
      { src: '/seminar/projects/2025-nokisaki-poster.jpg', alt: 'シール投票のアンケート用紙を手描きする学生たち' },
      { src: '/seminar/projects/2025-nokisaki-camera.jpg', alt: '滞在人数を計測するカメラと掲示' },
      { src: '/seminar/projects/2025-nokisaki-board.jpg', alt: '会場に置いたシール投票のアンケートとソトマナビののぼり' },
      { src: '/seminar/projects/2025-nokisaki-analysis.jpg', alt: '集めたデータを分析する学生たち' },
      { src: '/seminar/projects/2025-nokisaki-report.jpg', alt: '調査結果を報告する学生たち' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2025,
    when: '2025年5月',
    title: 'スマホ相談教室＠コープ稲美',
    text: 'コープ稲美で、今年もスマホ相談教室を開きました。申し込み不要・参加無料で、学生が一人ひとりの相談に付きました。',
    photo: '/seminar/projects/2025-inami-room.jpg',
    alt: '学生と地域の方が向かい合ってスマホの相談をする会場',
    more: [
      { src: '/seminar/projects/2025-inami-board.jpg', alt: 'ホワイトボードに「スマホ相談教室」と書く学生' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2025,
    when: '2025年4月',
    title: 'コンセンサスゲームとチームビルディング',
    text: '新しいゼミの始まりに、コンセンサスゲームやカードゲームで、話し合って決める練習とチームづくりをしました。',
    photo: '/seminar/projects/2025-teambuilding-1.jpg',
    alt: 'コンセンサスゲームで手を挙げて意見を出し合う学生たち',
    more: [
      { src: '/seminar/projects/2025-teambuilding-2.jpg', alt: 'カードゲームで協力する学生たち' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2024,
    when: '2024年12月',
    title: '神沢鉄工（三木市）を訪問',
    text: '三木市の神沢鉄工を訪ね、刃物ブランド「FEDECA」の取り組みを伺いました。学生からも、他地域のものづくりブランドを調べた内容を発表しました。',
    photo: '/seminar/projects/2024-kanzawa-1.jpg',
    alt: 'ナイフが並ぶショールームで、ブランドの説明を聞く学生たち',
    more: [
      { src: '/seminar/projects/2024-kanzawa-2.jpg', alt: '提供する価値について説明を聞く学生たち' },
      { src: '/seminar/projects/2024-kanzawa-3.jpg', alt: '調べた事例を発表する学生' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年11月',
    title: 'スマホ教室＠東加古川軒先市場',
    text: 'クリスマスの飾りつけで、東加古川軒先市場にスマホ教室を出しました。手描きの看板を見て立ち寄ってくれた方に、学生が1対1で付きました。',
    photo: '/seminar/projects/2024-nokisaki-xmas-board.jpg',
    alt: '学生が描いた「冬のスマホ教室やってます！」の看板',
    more: [
      { src: '/seminar/projects/2024-nokisaki-xmas-consult.jpg', alt: '学生が地域の方のスマホの相談に応じる様子' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年11月',
    title: 'クリスマススマホ教室＠コープ稲美',
    text: 'クリスマス仕立てのスマホ教室を、コープ稲美で開きました。会場の飾りつけやホワイトボード、チラシづくりも学生の手によるものです。',
    photo: '/seminar/projects/2024-xmas-board.jpg',
    alt: '学生が描いたホワイトボードと、クリスマスの飾りつけをした受付',
    more: [
      { src: '/seminar/projects/2024-xmas-selfie.jpg', alt: '参加者の方と学生がスマホで一緒に記念撮影する様子' },
      { src: '/seminar/projects/2024-xmas-room.jpg', alt: '学生と地域の方が向かい合って座る会場' },
      { src: '/seminar/projects/2024-xmas-poster.jpg', alt: 'クリスマススマホ教室のポスター' },
      { src: '/seminar/projects/2024-xmas-table.jpg', alt: '学生が手描きした案内とクリスマスの飾り' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年7月',
    title: 'スマホ教室＠コープ稲美',
    text: 'コープ稲美で、地域の方のスマホの使い方の相談に、学生が1人ずつ付いて一緒に向き合いました。',
    photo: '/seminar/projects/2024-inami-smartphone-poster.jpg',
    alt: 'スマホ教室の案内ポスターと、学生が書いたホワイトボード',
    more: [
      { src: '/seminar/projects/2024-inami-smartphone-2.jpg', alt: '学生と地域の方が、机の上のスマホを一緒にのぞき込む様子' },
      { src: '/seminar/projects/2024-inami-smartphone-3.jpg', alt: '学生2人が地域の方のスマホの操作を手伝う様子' },
      { src: '/seminar/projects/2024-inami-smartphone-class.jpg', alt: '店舗の一室で、学生と地域の方が向かい合ってスマホを操作する様子' },
    ],
  },
  {
    tags: ['ゼミ'],
    year: 2024,
    when: '2024年6月',
    title: '東加古川軒先市場の調査',
    text: '手動のカウンターとAIカメラで、軒先市場に来る人の流れを調べ、来場者アンケートとあわせて分析して報告しました。この取り組みは神戸新聞で大きく紹介されました。',
    photo: '/seminar/projects/2024-nokisaki-survey-camera.jpg',
    alt: '人数を数えるAIカメラと、個人情報を取得しない旨の掲示',
    more: [
      { src: '/seminar/projects/2024-kobe-np.jpg', alt: '神戸新聞の記事「地域活性化へデータ活用」（本文はぼかしています）' },
      { src: '/seminar/projects/2024-nokisaki-survey-walk.jpg', alt: '調査ルートを歩く学生たち' },
      { src: '/seminar/projects/2024-nokisaki-survey-report.jpg', alt: '調査の方法を説明する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-1.jpg', alt: '来場者アンケートの結果を報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-2.jpg', alt: 'イベントを知った経路の結果を報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-4.jpg', alt: '手動カウンターとAIカメラの計測結果を比べて報告する学生' },
      { src: '/seminar/projects/2024-nokisaki-result-6.jpg', alt: 'AIカメラの計測結果を解説する様子' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年5月',
    title: 'スマホ教室＠東加古川軒先市場',
    text: '東加古川軒先市場に出張して、まちの人のスマホの困りごとに学生が一緒に向き合いました。',
    photo: '/seminar/projects/2024-nokisaki-smartphone-class.jpg',
    alt: 'スマホの使い方を一緒に確かめる学生と来場者',
    more: [
      { src: '/seminar/projects/2024-nokisaki-smartphone-board.jpg', alt: 'ホワイトボードに「スマホ教室」と書く学生たち' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年4〜5月',
    title: 'スマホ相談会',
    text: 'コープの店舗で、学生が相談役になってスマホ相談会を開きました。準備から当日の対応まで、学生が進めています。',
    photo: '/seminar/projects/2024-smartphone-consult.jpg',
    alt: '学生と一緒にスマホを操作する相談者',
    more: [
      { src: '/seminar/projects/2024-smartphone-class.jpg', alt: 'スマホの操作を一緒に確かめる学生と相談者' },
      { src: '/seminar/projects/2024-smartphone-prep.jpg', alt: '教室で相談会の準備をする学生たち' },
    ],
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2024,
    when: '2024年2月',
    title: 'TSUMAMIGUI TIME',
    text: 'コープこうべの直営農場「コープエコファーム」の資源循環の取り組みを紹介しようと、採れた野菜を使ってクルチャの試食会を開きました。',
    photo: '/seminar/projects/2024-tsumamigui-plates.jpg',
    alt: '皿に盛りつけた試食用のクルチャ',
    more: [
      { src: '/seminar/projects/2024-tsumamigui-trial.jpg', alt: '試作したクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-prep.jpg', alt: '調理室で仕込みを始める学生' },
      { src: '/seminar/projects/2024-tsumamigui-time.jpg', alt: 'フライパンで焼いているほうれん草とチーズのクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-banner.jpg', alt: '試食会ののぼり' },
      { src: '/seminar/projects/2024-tsumamigui-booth.jpg', alt: '開始前の試食会のブース' },
    ],
    link: { href: 'https://www.instagram.com/p/C34ELkVp7wW/', label: 'Instagramで見る' },
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2022,
    title: '未知を感じる自然ツアー',
    text: '自然の中で、子どもたちが小さな挑戦を重ねて自分を知っていくツアーを企画し、実施しました。',
    photo: '/seminar/projects/2022-michi-nature-tour.jpg',
    alt: '企画を書き出したホワイトボード',
  },
  {
    tags: ['プロジェクト演習', 'ソトマナビ'],
    year: 2022,
    title: 'ソトマナビ広報',
    text: '学生のアクティブラーニングの活動を、ポスターにして展示しました。',
    photo: '/seminar/projects/2022-sotomanabi-poster.jpg',
    alt: '教室に並んだポスターを見る学生たち',
