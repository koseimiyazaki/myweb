---
import Base from '../layouts/Base.astro';
import NoteFeed from '../components/NoteFeed.astro';
import { site } from '../data/site';

// 用件（短い名詞）＋ひとこと（話しかける口調）。並びは きく→しらべる→つくる の順。
const activities = [
  { verb: 'きいて・しらべて', title: 'まちのアンケート', say: '東加古川軒先市場で、まちの声をきいています。', since: '2024年〜' },
  { verb: 'つくります', title: '兵庫のブランドのnote', say: 'じっさいに つかって、たずねて、かいています。', since: '2026年〜' },
];

// これまでの企画。新しいものを上に足す。写真は public/seminar/projects/ に、位置情報を消して置く。
const projects = [
  {
    year: 2024,
    when: '2024年2月',
    title: 'TSUMAMIGUI TIME',
    text: 'コープこうべの直営農場「コープエコファーム」の資源循環の取り組みを紹介しようと、採れた野菜を使ってクルチャの試食会を開きました。',
    photo: '/seminar/projects/2024-tsumamigui-plates.jpg',
    alt: '皿に盛りつけた試食用のクルチャ',
    more: [
      { src: '/seminar/projects/2024-tsumamigui-trial.jpg', alt: '試作したクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-prep.jpg', alt: '調理室で仕込みを始める学生' },
      { src: '/seminar/projects/2024-tsumamigui-time.jpg', alt: 'フライパンで焼いているほうれん草とチーズのクルチャ' },
      { src: '/seminar/projects/2024-tsumamigui-banner.jpg', alt: '試食会ののぼり' },
      { src: '/seminar/projects/2024-tsumamigui-booth.jpg', alt: '開始前の試食会のブース' },
    ],
    link: { href: 'https://www.instagram.com/p/C34ELkVp7wW/', label: 'Instagramで見る' },
  },
  {
    year: 2022,
    title: '未知を感じる自然ツアー',
    text: '自然の中で、子どもたちが小さな挑戦を重ねて自分を知っていくツアーを企画し、実施しました。',
    photo: '/seminar/projects/2022-michi-nature-tour.jpg',
    alt: '企画を書き出したホワイトボード',
  },
  {
    year: 2022,
    title: 'ソトマナビ広報',
    text: '学生のアクティブラーニングの活動を、ポスターにして展示しました。',
    photo: '/seminar/projects/2022-sotomanabi-poster.jpg',
    alt: '教室に並んだポスターを見る学生たち',
  },
];
---
<Base>
  <section class="banner">
    <div class="banner__inner wrap">
      <img class="banner__logo" src="/seminar/logo_yoko_yellow.png" alt="兵庫大学 現代ビジネス学部 みやざきゼミ" width="1600" height="341" />
      <p class="banner__copy hand"><span>きいて、</span><span>しらべて、</span><span>つくります。</span></p>
    </div>
  </section>

  <div class="wrap semi-body">
    <p class="semi-lead">まちの人の話をきき、データでしらべ、わかったことをかたちにします。まちのことを気軽に聞きに来られる「近所の大学生」をめざしています。</p>

    <div class="scenes">
      <figure class="scene">
        <img src="/seminar/projects/2023-seminar-scene.jpg" alt="ゼミの教室で、スクリーンの映像を見ながら話し合う学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>2023年のゼミ</figcaption>
      </figure>
      <figure class="scene">
        <img src="/seminar/projects/seminar-scene-gallery.jpg" alt="壁に貼った資料を見て回る学生たち" width="1024" height="768" loading="lazy" />
        <figcaption>ゼミの風景</figcaption>
      </figure>
    </div>


    <h2 class="semi-h2">やっていること</h2>
    <div class="semi-boards">
      {activities.map((a) => (
        <article class="board">
          <p class="board__verb">{a.verb}</p>
          <h3 class="board__title">{a.title}</h3>
          <p class="board__say hand">{a.say}</p>
          <p class="board__since">{a.since}</p>
        </article>
      ))}
    </div>

    <h2 class="semi-h2">これまでの企画</h2>
    <div class="projects">
      {projects.map((p) => (
        <figure class="project">
          <img class="project__main" src={p.photo} alt={p.alt} loading="lazy" />
          {p.more && (
            <div class="project__thumbs">
              {[{ src: p.photo, alt: p.alt }, ...p.more].map((m, i) => (
                <button type="button" class="project__thumb" aria-pressed={i === 0 ? 'true' : 'false'} data-src={m.src} data-alt={m.alt} aria-label={`写真${i + 1}を表示`}>
                  <img src={m.src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
          <figcaption>
            <p class="project__year">{p.when ?? `${p.year}年`}</p>
            <h3 class="project__title">{p.title}</h3>
            <p class="project__text">{p.text}</p>
            {p.link && <p class="project__link"><a href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a></p>}
          </figcaption>
        </figure>
      ))}
    </div>

    <NoteFeed noteId={site.seminarNoteId} heading="ゼミのnote" />

    <p class="semi-formal">兵庫大学 現代ビジネス学部 宮崎ゼミ</p>
  </div>
  <script is:inline>
    document.querySelectorAll('.project__thumbs').forEach((row) => {
      const main = row.parentElement.querySelector('.project__main');
      row.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        main.src = b.dataset.src; main.alt = b.dataset.alt;
        row.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', x === b));
      }));
    });
  </script>
</Base>
